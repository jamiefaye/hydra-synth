{
 "_about": "Faderfox EC4 setup 2 as a Korg nanoKONTROL2 for bddap-bot/lightherder: encoders send the nano's fader (CC 0-7) and rotary (CC 16-23) controls absolute on ch 1; pushes send the nano's buttons as CC 127 on press, 0 on release (push mode Key). Apply with: node extensions/midi/tools/ec4-label.js apply <backup.syx> <out.syx> dev/lightherder-ec4-labels.json",
 "_pushes": {
  "NANO": {
   "1-5": "focus monitor upper A, lower A, upper B, lower B, rotating (M1-5)",
   "6": "select: monitor on program / own camera (R8)",
   "7": "reverse the focused switcher (R5)",
   "8": "cut: hold to throw the switcher (marker prev)",
   "9-11": "focus camera A, B, 3 (S1-3)",
   "12": "rewind: last knob back to identity",
   "13-16": "focus switcher A, B, C, D (R1-4)"
  },
  "XTRA": {
   "1": "flip x (R6)",
   "2": "flip y (R7)",
   "3": "blank every monitor (marker next)",
   "4": "stop: reset every knob",
   "5": "cycle: overlay on/off",
   "6": "forward: solo the focused monitor",
   "7": "marker set: write a frame",
   "8": "record while held",
   "9-16": "same as NANO"
  }
 },
