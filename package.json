{
  "name": "hydra-synth",
  "version": "1.4.0",
  "description": "base synth for hydra-editor",
  "type": "module",
  "main": "./dist/hydra-synth.umd.js",
  "module": "./dist/hydra-synth.es.js",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/hydra-synth.es.js",
      "require": "./dist/hydra-synth.umd.js"
    },
    "./src/glsl/glsl-functions.js": {
      "import": "./src/glsl/glsl-functions.js",
      "require": "./src/glsl/glsl-functions.js"
    },
    "./extensions/vertex": {
      "import": "./extensions/vertex/index.js"
    },
    "./extensions/vertex/webgpu": {
      "import": "./extensions/vertex/index-webgpu.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:vertex": "npm run build:vertex-webgl && npm run build:vertex-webgpu",
    "build:vertex-webgl": "VERTEX_TARGET=webgl vite build --config vite.config.vertex.js",
    "build:vertex-webgpu": "VERTEX_TARGET=webgpu vite build --config vite.config.vertex.js"
  },
  "dependencies": {
    "acorn": "^8.7.0",
    "acorn-loose": "^8.5.0",
    "astravel": "^0.5.0",
    "astring": "^1.4.0",
    "meyda": "^5.6.3",
    "raf-loop": "^1.1.3",
    "regl": "^2.1.1",
    "webgpu-utils": "^1.10.1"
  },
  "devDependencies": {
    "vite": "^6.2.0"
  }
}
